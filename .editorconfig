root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = tab
trim_trailing_whitespace = true
max_line_length = 120
[{*.yml,*.yaml}]
indent_style = space
indent_size = 2
# Kotlin configs
[*.kt]
ij_kotlin_name_count_to_use_star_import = unset
ij_kotlin_name_count_to_use_star_import_for_members = unset